# --------------------------------------------------------------------------
# Production environment variables for Benchbook.
# Copy the relevant block into your hosting provider's env-var UI.
# --------------------------------------------------------------------------

# === Frontend (Vercel) ===========================================
# These all need the VITE_ prefix so they're embedded into the bundle.

VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable / anon key — safe to ship in the browser bundle.
# Both names are accepted; we standardised on VITE_SUPABASE_PUBLISHABLE_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the Vercel-hosted backend API (no trailing slash).
VITE_API_URL=https://your-backend.vercel.app

# === Backend (Vercel serverless) =================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET — never ship to the browser. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Used only by scripts/migrate.ts. Not required at request-time.
SUPABASE_DB_PASSWORD=xxxxxxxxxxxxxxxx

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Where the React app lives — used to build share URLs and for CORS.
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# PORT is only needed for local / self-hosted runs. On Vercel the platform owns
# the runtime and the app never binds a port (see `if (!process.env.VERCEL)` in
# src/index.ts), so leave PORT unset in production.
NODE_ENV=production

# Optional — paste the DSN from your Sentry project (sentry.io → Settings →
# Projects → benchbook-backend → Client Keys). Sentry only initialises when
# this is set AND NODE_ENV=production, so dev runs never ship telemetry.
SENTRY_DSN=https://your-dsn@sentry.io/project-id
