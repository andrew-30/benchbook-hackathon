{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    // vite.config.ts runs in Node (uses process.env). Scope node globals here
    // rather than relying on @types/node being transitively hoisted — a clean
    // CI install may not hoist it, which broke the Vercel build (TS2580).
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
